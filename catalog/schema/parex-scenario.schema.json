{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://parex-validation-lab.local/schema/parex-scenario.schema.json",
    "title": "PAREX Validation Lab Semantic Scenario",
    "description": "Contrato semántico común para EUV, validaciones funcionales y precondiciones automatizadas del PAREX Validation Lab.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "id",
        "name",
        "kind",
        "status",
        "environment",
        "objective",
        "scenario",
        "risk",
        "coverage",
        "automation",
        "preconditions",
        "testability_contract",
        "evidence",
        "tags",
        "suites",
        "architecture",
        "sequence"
    ],
    "properties": {
        "schema_version": {
            "type": "integer",
            "const": 1
        },
        "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(EUV|VAL|PRE)-[A-Z0-9-]+$"
        },
        "name": {
            "type": "string",
            "minLength": 1
        },
        "kind": {
            "type": "string",
            "enum": [
                "euv",
                "validation",
                "precondition"
            ]
        },
        "status": {
            "type": "string",
            "enum": [
                "planned",
                "automated",
                "manual",
                "deprecated"
            ]
        },
        "environment": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "allowed",
                "default"
            ],
            "properties": {
                "allowed": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "enum": [
                            "dev",
                            "pro"
                        ]
                    }
                },
                "default": {
                    "type": "string",
                    "enum": [
                        "dev",
                        "pro"
                    ]
                }
            }
        },
        "use_case": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "name"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1
                },
                "name": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "capability": {
            "type": "string",
            "minLength": 1
        },
        "objective": {
            "type": "string",
            "minLength": 1
        },
        "scenario": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "given",
                "when",
                "then"
            ],
            "properties": {
                "given": {
                    "$ref": "#/$defs/nonEmptyStringArray"
                },
                "when": {
                    "$ref": "#/$defs/nonEmptyStringArray"
                },
                "then": {
                    "$ref": "#/$defs/nonEmptyStringArray"
                }
            }
        },
        "risk": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "level",
                "description"
            ],
            "properties": {
                "level": {
                    "type": "string",
                    "enum": [
                        "low",
                        "medium",
                        "high",
                        "critical"
                    ]
                },
                "description": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "coverage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "count_as_scenario"
            ],
            "properties": {
                "count_as_scenario": {
                    "type": "boolean"
                }
            }
        },
        "automation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "framework",
                "project",
                "spec"
            ],
            "properties": {
                "framework": {
                    "type": "string",
                    "const": "playwright"
                },
                "project": {
                    "type": "string",
                    "minLength": 1
                },
                "spec": {
                    "type": "string",
                    "minLength": 1
                },
                "runtime_id_template": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "preconditions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "testability_contract": {
            "type": "array",
            "uniqueItems": true,
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "enum": [
                    "execution-result",
                    "duration",
                    "screenshot",
                    "screenshot-on-failure",
                    "video",
                    "video-on-failure",
                    "trace",
                    "trace-on-failure",
                    "json-state"
                ]
            }
        },
        "tags": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
        },
        "suites": {
            "type": "array",
            "uniqueItems": true,
            "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
        },
        "architecture": {
            "type": "array",
            "uniqueItems": true,
            "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
        },
        "sequence": {
            "type": "integer",
            "minimum": 0
        }
    },
    "$defs": {
        "nonEmptyStringArray": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "string",
                "minLength": 1
            }
        }
    },
    "allOf": [
        {
            "if": {
                "properties": {
                    "kind": {
                        "const": "euv"
                    }
                },
                "required": [
                    "kind"
                ]
            },
            "then": {
                "properties": {
                    "use_case": {}
                },
                "required": [
                    "use_case"
                ]
            }
        },
        {
            "if": {
                "properties": {
                    "kind": {
                        "const": "validation"
                    }
                },
                "required": [
                    "kind"
                ]
            },
            "then": {
                "properties": {
                    "capability": {}
                },
                "required": [
                    "capability"
                ]
            }
        },
        {
            "if": {
                "properties": {
                    "kind": {
                        "const": "precondition"
                    }
                },
                "required": [
                    "kind"
                ]
            },
            "then": {
                "properties": {
                    "capability": {},
                    "coverage": {
                        "type": "object",
                        "properties": {
                            "count_as_scenario": {
                                "const": false
                            }
                        }
                    }
                },
                "required": [
                    "capability"
                ]
            }
        }
    ]
}