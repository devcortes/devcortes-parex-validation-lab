                    "editorMode": "code",
                    "format": "table",
                    "rawQuery": true,
                    "rawSql": "WITH latest AS (SELECT run_id FROM test_runs WHERE environment = '${environment}' ORDER BY started_at DESC LIMIT 1) SELECT r.test_id AS \"Test\", r.test_type AS \"Tipo\", COALESCE(r.use_case, '-') AS \"Caso de uso\", r.status AS \"Estado\", ROUND(r.duration_ms / 1000.0, 2) AS \"Duración (s)\", CASE WHEN r.has_workaround THEN 'SI' ELSE 'NO' END AS \"Workaround\", COALESCE(r.known_issue, '-') AS \"Defecto\" FROM test_results r JOIN latest l ON l.run_id = r.run_id ORDER BY CASE r.test_type WHEN 'PRECONDITION' THEN 0 WHEN 'EUV' THEN 1 WHEN 'VALIDATION' THEN 2 ELSE 3 END, r.test_id;",
                    "refId": "A"
                }
            ],
